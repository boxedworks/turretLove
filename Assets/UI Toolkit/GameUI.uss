:root {
    --ink: rgb(235, 242, 239);
    --muted-ink: rgb(151, 170, 164);
    --panel: rgba(10, 24, 26, 0.94);
    --panel-edge: rgb(49, 103, 95);
    --accent: rgb(242, 174, 76);
    --accent-dark: rgb(150, 91, 36);
    --danger: rgb(220, 92, 78);
}

.screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(8, 18, 22);
}

.menu-panel {
    width: 420px;
    min-height: 490px;
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 42px;
    padding-bottom: 42px;
    align-items: center;
    background-color: var(--panel);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.kicker {
    color: var(--accent);
    font-size: 13px;
    letter-spacing: 3px;
    margin-bottom: 12px;
}

.title {
    color: var(--ink);
    font-size: 52px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.subtitle {
    color: var(--muted-ink);
    font-size: 15px;
    margin-bottom: 38px;
}

.menu-button {
    width: 300px;
    height: 54px;
    margin-bottom: 12px;
    color: var(--ink);
    background-color: rgba(28, 57, 57, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
    font-size: 17px;
    -unity-font-style: bold;
}

.menu-button:hover,
.menu-button:focus {
    color: rgb(15, 27, 27);
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.menu-button:active {
    background-color: var(--accent-dark);
}

.exit-button {
    color: var(--danger);
    margin-top: 10px;
}

.exit-button:hover,
.exit-button:focus {
    color: rgb(35, 13, 13);
    background-color: var(--danger);
    border-left-color: var(--danger);
    border-right-color: var(--danger);
    border-top-color: var(--danger);
    border-bottom-color: var(--danger);
}

.status {
    min-height: 22px;
    margin-top: 22px;
    color: var(--muted-ink);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.footer {
    position: absolute;
    bottom: 18px;
    color: rgb(92, 119, 112);
    font-size: 11px;
}

.save-selection-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 11, 13, 0.82);
}

.save-selection-panel {
    width: 480px;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 28px;
    padding-bottom: 24px;
    background-color: var(--panel);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.save-selection-title {
    color: var(--accent);
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.save-selection-message {
    min-height: 20px;
    margin-top: 8px;
    margin-bottom: 12px;
    color: var(--muted-ink);
    font-size: 12px;
}

.save-slot-list {
    margin-bottom: 12px;
}

.save-slot-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 58px;
    margin-bottom: 8px;
    padding-left: 12px;
    padding-right: 8px;
    background-color: rgb(28, 57, 57);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.save-slot-active {
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.save-slot-label {
    color: var(--ink);
    font-size: 14px;
    -unity-font-style: bold;
}

.save-slot-state {
    color: var(--muted-ink);
    font-size: 10px;
}

.save-slot-actions {
    flex-direction: row;
    align-items: center;
}

.save-slot-action,
.save-selection-back-button {
    min-height: 30px;
    margin-left: 6px;
    color: var(--ink);
    background-color: rgba(10, 24, 26, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
    font-size: 10px;
}

.save-slot-delete {
    color: var(--danger);
    border-left-color: var(--danger);
    border-right-color: var(--danger);
    border-top-color: var(--danger);
    border-bottom-color: var(--danger);
}

.save-slot-confirm-delete {
    color: rgb(35, 13, 13);
    background-color: var(--danger);
}

.save-selection-back-button {
    width: 100%;
    margin-left: 0;
}

.command-center-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 11, 13, 0.82);
}

.command-center-panel {
    width: 88%;
    height: 86%;
    max-width: 1680px;
    max-height: 930px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 22px;
    padding-bottom: 20px;
    background-color: var(--panel);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.command-center-header,
.command-level-row,
.command-center-dashboard {
    flex-direction: row;
    align-items: center;
}

.command-center-header {
    justify-content: space-between;
}

.command-center-title {
    color: var(--accent);
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.command-center-note,
.command-log-output {
    color: var(--muted-ink);
    font-size: 13px;
}

.command-center-dashboard {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: stretch;
}

.command-dashboard-column {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 12px;
    padding-right: 12px;
    border-right-width: 1px;
    border-right-color: var(--panel-edge);
}

.command-arsenal-column {
    margin-right: 0;
    padding-right: 0;
    border-right-width: 0;
}

.command-center-back-button,
.command-start-button,
.command-area-button,
.command-level-button,
.command-action-button {
    color: var(--ink);
    background-color: rgb(28, 57, 57);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
    font-size: 11px;
}

.command-center-back-button {
    height: 30px;
}

.command-center-section-title {
    color: var(--accent);
    margin-top: 9px;
    margin-bottom: 3px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.command-center-selection-label {
    color: var(--ink);
    font-size: 16px;
    -unity-font-style: bold;
}

.command-center-note {
    margin-top: 3px;
    margin-bottom: 6px;
}

.command-selection-field {
    margin-top: 4px;
    margin-bottom: 6px;
    color: var(--ink);
    font-size: 11px;
}

.command-selection-field .unity-base-field__label {
    min-width: 44px;
    color: var(--muted-ink);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.command-selection-field .unity-base-popup-field__text {
    color: var(--ink);
}

.command-selection-field .unity-base-popup-field__input {
    background-color: rgb(28, 57, 57);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.command-area-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.command-area {
    width: 100%;
    margin-bottom: 5px;
}

.command-area-title {
    color: var(--muted-ink);
    margin-bottom: 5px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.command-area-button,
.command-level-button {
    flex-grow: 1;
    min-width: 0;
    height: 34px;
    margin-right: 4px;
}

.command-area-button:hover,
.command-area-button:focus,
.command-level-button:hover,
.command-level-button:focus,
.command-level-selected {
    color: rgb(15, 27, 27);
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.command-start-button {
    height: 38px;
    margin-top: 2px;
    color: rgb(15, 27, 27);
    background-color: var(--accent);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.command-start-button:disabled {
    color: var(--muted-ink);
    background-color: rgb(28, 57, 57);
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.command-log-panel {
    flex-grow: 1;
    justify-content: flex-end;
    min-height: 180px;
    margin-top: 16px;
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    background-color: rgba(3, 11, 13, 0.75);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.command-log-panel .command-center-section-title {
    margin-top: 5px;
}

.command-log-output {
    flex-grow: 1;
    color: rgb(126, 208, 180);
    font-size: 12px;
    white-space: normal;
}

.hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
}

.turret-status {
    position: absolute;
    left: 28px;
    bottom: 28px;
    width: 260px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: var(--panel);
    border-left-width: 2px;
    border-left-color: var(--panel-edge);
    border-bottom-width: 1px;
    border-bottom-color: var(--panel-edge);
}

.turret-status-title {
    color: var(--accent);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.turret-stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 18px;
}

.turret-stat-row-spaced {
    margin-top: 8px;
}

.turret-stat-label {
    color: var(--muted-ink);
    font-size: 12px;
    letter-spacing: 1px;
}

.turret-stat-value {
    color: var(--ink);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.health-bar {
    height: 10px;
    margin-top: 2px;
    background-color: rgb(35, 50, 48);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.health-bar-fill {
    height: 100%;
    width: 100%;
    background-color: var(--accent);
}

.turret-ammo-value {
    color: var(--accent);
}

.target-value {
    color: var(--accent);
    font-size: 18px;
    -unity-font-style: bold;
}

.skill-bar-container {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 28px;
    align-items: center;
}

.turret-target-outline {
    position: absolute;
    width: 56px;
    height: 56px;
    display: none;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.skill-bar {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.skill-slot {
    width: 84px;
    height: 84px;
    margin-left: 6px;
    margin-right: 6px;
}

.skill-icon {
    width: 100%;
    height: 100%;
    background-color: rgb(28, 57, 57);
    -unity-background-scale-mode: scale-and-crop;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.skill-uses {
    color: var(--ink);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(8, 18, 22);
}

.skill-recharge-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.dash-direction-indicator {
    position: absolute;
    width: 48px;
    height: 48px;
    display: none;
    color: var(--accent);
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(8, 18, 22);
}

.held-direction-indicator {
    position: absolute;
    width: 48px;
    height: 48px;
    display: none;
    color: var(--muted-ink);
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(8, 18, 22);
}

.command-resource-list,
.command-card-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.command-inventory-grid {
    flex-grow: 3;
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.command-inventory-panel {
    flex-grow: 1;
    margin-top: 8px;
    margin-bottom: 6px;
    padding-left: 6px;
    padding-right: 2px;
    padding-bottom: 2px;
    background-color: rgba(28, 57, 57, 0.3);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.command-inventory-panel .command-center-section-title {
    margin-top: 5px;
}

.command-inventory-preview {
    flex-grow: 1;
    min-height: 150px;
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(8, 18, 22, 0.55);
    border-top-width: 1px;
    border-top-color: var(--panel-edge);
}

.command-inventory-preview-icon {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    margin-right: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.command-inventory-preview-details {
    flex-grow: 1;
    color: var(--muted-ink);
    font-size: 13px;
    white-space: normal;
}

.command-inventory-preview-details > .command-crafting-bench-detail,
.command-inventory-preview-details > .command-crafting-bench-info-tab {
    margin-bottom: 3px;
}

.command-inventory-preview-details > .command-crafting-bench-detail {
    font-size: 11px;
}

.command-inventory-preview-details > .command-crafting-bench-stat {
    font-size: 11px;
}

.command-icon-tile {
    position: relative;
    width: 46px;
    height: 46px;
    margin-right: 4px;
    margin-bottom: 4px;
    background-color: rgb(28, 57, 57);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.command-item-icon {
    width: 100%;
    height: 100%;
    background-color: rgb(48, 88, 82);
    -unity-background-scale-mode: scale-to-fit;
}

.command-drag-ghost {
    position: absolute;
    width: 46px;
    height: 46px;
    opacity: 0.8;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.command-icon-empty-slot {
    background-color: rgb(16, 37, 39);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--muted-ink);
    border-right-color: var(--muted-ink);
    border-top-color: var(--muted-ink);
    border-bottom-color: var(--muted-ink);
}

.command-item-badge {
    position: absolute;
    right: 2px;
    bottom: 1px;
    min-width: 14px;
    color: var(--ink);
    background-color: rgb(8, 18, 22);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.command-runtime-tooltip {
    position: absolute;
    display: none;
    max-width: 260px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    color: var(--ink);
    background-color: rgba(3, 11, 13, 0.97);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
    font-size: 11px;
    white-space: normal;
}

.command-action-button {
    width: 50px;
    height: 50px;
    margin-right: 4px;
    margin-bottom: 4px;
    padding-left: 1px;
    padding-right: 1px;
    padding-top: 1px;
    padding-bottom: 1px;
    color: var(--ink);
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.command-action-button .command-icon-tile {
    margin-right: 0;
    margin-bottom: 0;
}

.command-action-button:hover .command-icon-tile,
.command-action-button:focus .command-icon-tile {
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.command-card-selected {
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.command-crafting-bench {
    margin-top: 10px;
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    background-color: rgba(8, 18, 22, 0.55);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.command-crafting-bench .command-center-section-title {
    margin-top: 5px;
}

.command-crafting-bench-slot {
    min-height: 62px;
    align-items: center;
    justify-content: center;
    background-color: rgba(28, 57, 57, 0.45);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.command-crafting-bench-slot .command-icon-tile {
    margin-right: 0;
    margin-bottom: 0;
}

.command-crafting-bench-details {
    min-height: 120px;
    margin-top: 8px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgba(8, 18, 22, 0.55);
}

.command-crafting-bench-detail {
    margin-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    color: var(--ink);
    background-color: rgba(28, 57, 57, 0.75);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
    font-size: 12px;
    white-space: normal;
}

.command-crafting-bench-detail-header {
    color: var(--accent);
    background-color: rgba(48, 88, 82, 0.75);
    -unity-font-style: bold;
}

.command-crafting-bench-info-tab {
    margin-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 1px;
    padding-bottom: 1px;
    background-color: rgba(28, 57, 57, 0.75);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
    font-size: 6px;
}

.command-crafting-bench-stat {
    flex-direction: row;
    justify-content: space-between;
    min-height: 16px;
    color: var(--ink);
    font-size: 12px;
}

.command-crafting-bench-stat-value {
    -unity-text-align: middle-right;
}

#command-crafting-bench-empty-details {
    color: var(--muted-ink);
    font-size: 13px;
    white-space: normal;
}

.command-magazine-slot {
    margin-right: 6px;
}

.command-salvage-button {
    width: 22px;
    height: 22px;
    margin-top: 2px;
    margin-left: 12px;
    margin-right: 12px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: transparent;
}

.command-salvage-button .command-icon-tile {
    width: 20px;
    height: 20px;
    border-left-color: var(--danger);
    border-right-color: var(--danger);
    border-top-color: var(--danger);
    border-bottom-color: var(--danger);
}

.command-icon-salvage {
    background-color: var(--danger);
}

.command-card-list > .command-icon-tile:hover,
.command-card-list > .command-icon-tile:focus {
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.command-icon-bullet-single,
.command-icon-bullet-shotgun,
.command-icon-bullet-burst {
    background-color: rgb(113, 135, 126);
}

.command-icon-item-mana,
.command-icon-item-wood,
.command-icon-item-stone,
.command-icon-item-emerald,
.command-icon-item-sapphire,
.command-icon-item-ruby,
.command-icon-item-diamond,
.command-icon-item-scrap,
.command-icon-item-powder,
.command-icon-item-catalyst,
.command-icon-item-ember,
.command-icon-item-toxin,
.command-icon-conversion {
    background-color: rgb(73, 115, 106);
}

.command-icon-item-ember,
.command-icon-item-ruby {
    background-color: rgb(139, 77, 59);
}

.command-icon-item-toxin,
.command-icon-item-emerald {
    background-color: rgb(57, 125, 85);
}

.command-icon-item-powder,
.command-icon-item-mana {
    background-color: rgb(67, 105, 145);
}

.command-salvage-button {
    background-color: transparent;
}
