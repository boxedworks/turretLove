:root {
    --ink: rgb(235, 242, 239);
    --muted-ink: rgb(151, 170, 164);
    --panel: rgba(10, 24, 26, 0.94);
    --panel-edge: rgb(49, 103, 95);
    --accent: rgb(242, 174, 76);
    --accent-dark: rgb(150, 91, 36);
    --danger: rgb(220, 92, 78);
}

.screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(8, 18, 22);
}

.menu-panel {
    width: 420px;
    min-height: 490px;
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 42px;
    padding-bottom: 42px;
    align-items: center;
    background-color: var(--panel);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.kicker {
    color: var(--accent);
    font-size: 13px;
    letter-spacing: 3px;
    margin-bottom: 12px;
}

.title {
    color: var(--ink);
    font-size: 52px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.subtitle {
    color: var(--muted-ink);
    font-size: 15px;
    margin-bottom: 38px;
}

.menu-button {
    width: 300px;
    height: 54px;
    margin-bottom: 12px;
    color: var(--ink);
    background-color: rgba(28, 57, 57, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
    font-size: 17px;
    -unity-font-style: bold;
}

.menu-button:hover,
.menu-button:focus {
    color: rgb(15, 27, 27);
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.menu-button:active {
    background-color: var(--accent-dark);
}

.exit-button {
    color: var(--danger);
    margin-top: 10px;
}

.exit-button:hover,
.exit-button:focus {
    color: rgb(35, 13, 13);
    background-color: var(--danger);
    border-left-color: var(--danger);
    border-right-color: var(--danger);
    border-top-color: var(--danger);
    border-bottom-color: var(--danger);
}

.status {
    min-height: 22px;
    margin-top: 22px;
    color: var(--muted-ink);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.footer {
    position: absolute;
    bottom: 18px;
    color: rgb(92, 119, 112);
    font-size: 11px;
}

.hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
}

.turret-status {
    position: absolute;
    left: 28px;
    bottom: 28px;
    width: 224px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: var(--panel);
    border-left-width: 2px;
    border-left-color: var(--panel-edge);
    border-bottom-width: 1px;
    border-bottom-color: var(--panel-edge);
}

.turret-status-title {
    color: var(--accent);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.turret-stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 18px;
}

.turret-stat-row-spaced {
    margin-top: 8px;
}

.turret-stat-label {
    color: var(--muted-ink);
    font-size: 10px;
    letter-spacing: 1px;
}

.turret-stat-value {
    color: var(--ink);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.health-bar {
    height: 8px;
    margin-top: 2px;
    background-color: rgb(35, 50, 48);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.health-bar-fill {
    height: 100%;
    width: 100%;
    background-color: var(--accent);
}

.turret-ammo-value {
    color: var(--accent);
}

.target-value {
    color: var(--accent);
    font-size: 16px;
    -unity-font-style: bold;
}

.skill-bar-container {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 28px;
    align-items: center;
}

.turret-target-outline {
    position: absolute;
    width: 56px;
    height: 56px;
    display: none;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.skill-bar {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.skill-slot {
    width: 72px;
    height: 72px;
    margin-left: 6px;
    margin-right: 6px;
}

.skill-icon {
    width: 100%;
    height: 100%;
    background-color: rgb(28, 57, 57);
    -unity-background-scale-mode: scale-and-crop;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.skill-uses {
    color: var(--ink);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(8, 18, 22);
}

.skill-recharge-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.dash-direction-indicator {
    position: absolute;
    width: 48px;
    height: 48px;
    display: none;
    color: var(--accent);
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(8, 18, 22);
}

.held-direction-indicator {
    position: absolute;
    width: 48px;
    height: 48px;
    display: none;
    color: var(--muted-ink);
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(8, 18, 22);
}

@media (max-width: 600px) {
    .menu-panel {
        width: 90%;
        min-height: 440px;
        padding-left: 24px;
        padding-right: 24px;
    }

    .title {
        font-size: 40px;
    }

    .menu-button {
        width: 100%;
    }

    .turret-status {
        left: 16px;
        bottom: 16px;
        width: 200px;
    }

    .skill-bar-container {
        bottom: 92px;
    }

}
