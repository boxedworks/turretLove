:root {
    --ink: rgb(235, 242, 239);
    --muted-ink: rgb(151, 170, 164);
    --panel: rgba(10, 24, 26, 0.94);
    --panel-edge: rgb(49, 103, 95);
    --accent: rgb(242, 174, 76);
    --accent-dark: rgb(150, 91, 36);
    --danger: rgb(220, 92, 78);
}

.screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(8, 18, 22);
}

.menu-panel {
    width: 420px;
    min-height: 490px;
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 42px;
    padding-bottom: 42px;
    align-items: center;
    background-color: var(--panel);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.kicker {
    color: var(--accent);
    font-size: 13px;
    letter-spacing: 3px;
    margin-bottom: 12px;
}

.title {
    color: var(--ink);
    font-size: 52px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.subtitle {
    color: var(--muted-ink);
    font-size: 15px;
    margin-bottom: 38px;
}

.menu-button {
    width: 300px;
    height: 54px;
    margin-bottom: 12px;
    color: var(--ink);
    background-color: rgba(28, 57, 57, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
    font-size: 17px;
    -unity-font-style: bold;
}

.menu-button:hover,
.menu-button:focus {
    color: rgb(15, 27, 27);
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.menu-button:active {
    background-color: var(--accent-dark);
}

.exit-button {
    color: var(--danger);
    margin-top: 10px;
}

.exit-button:hover,
.exit-button:focus {
    color: rgb(35, 13, 13);
    background-color: var(--danger);
    border-left-color: var(--danger);
    border-right-color: var(--danger);
    border-top-color: var(--danger);
    border-bottom-color: var(--danger);
}

.status {
    min-height: 22px;
    margin-top: 22px;
    color: var(--muted-ink);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.footer {
    position: absolute;
    bottom: 18px;
    color: rgb(92, 119, 112);
    font-size: 11px;
}

.save-selection-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 11, 13, 0.82);
}

.save-selection-panel {
    width: 480px;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 28px;
    padding-bottom: 24px;
    background-color: var(--panel);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.save-selection-title {
    color: var(--accent);
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.save-selection-message {
    min-height: 20px;
    margin-top: 8px;
    margin-bottom: 12px;
    color: var(--muted-ink);
    font-size: 12px;
}

.save-slot-list {
    margin-bottom: 12px;
}

.save-slot-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 58px;
    margin-bottom: 8px;
    padding-left: 12px;
    padding-right: 8px;
    background-color: rgb(28, 57, 57);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.save-slot-active {
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.save-slot-label {
    color: var(--ink);
    font-size: 14px;
    -unity-font-style: bold;
}

.save-slot-state {
    color: var(--muted-ink);
    font-size: 10px;
}

.save-slot-actions {
    flex-direction: row;
    align-items: center;
}

.save-slot-action,
.save-selection-back-button {
    min-height: 30px;
    margin-left: 6px;
    color: var(--ink);
    background-color: rgba(10, 24, 26, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
    font-size: 10px;
}

.save-slot-delete {
    color: var(--danger);
    border-left-color: var(--danger);
    border-right-color: var(--danger);
    border-top-color: var(--danger);
    border-bottom-color: var(--danger);
}

.save-slot-confirm-delete {
    color: rgb(35, 13, 13);
    background-color: var(--danger);
}

.save-selection-back-button {
    width: 100%;
    margin-left: 0;
}

.command-center-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 11, 13, 0.82);
}

.command-center-panel {
    width: 660px;
    max-height: 88%;
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 24px;
    padding-bottom: 22px;
    background-color: var(--panel);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.command-center-header,
.command-workshop-section,
.command-level-row {
    flex-direction: row;
    align-items: center;
}

.command-center-header,
.command-workshop-section {
    justify-content: space-between;
}

.command-center-title {
    color: var(--accent);
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.command-center-save-label,
.command-center-note,
.command-center-message {
    color: var(--muted-ink);
    font-size: 11px;
}

.command-center-save-label {
    margin-top: 4px;
}

.command-center-back-button,
.command-workshop-button,
.command-start-button,
.command-level-button {
    color: var(--ink);
    background-color: rgb(28, 57, 57);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
    font-size: 11px;
}

.command-center-back-button {
    height: 30px;
}

.command-center-section-title {
    color: var(--accent);
    margin-top: 18px;
    margin-bottom: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.command-center-selection-label {
    color: var(--ink);
    font-size: 14px;
    -unity-font-style: bold;
}

.command-center-note {
    margin-top: 3px;
    margin-bottom: 12px;
}

.command-area-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.command-area {
    width: 50%;
    margin-bottom: 12px;
}

.command-area-title {
    color: var(--muted-ink);
    margin-bottom: 5px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.command-level-button {
    min-width: 76px;
    height: 34px;
    margin-right: 6px;
}

.command-level-button:hover,
.command-level-button:focus,
.command-level-selected {
    color: rgb(15, 27, 27);
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.command-start-button {
    height: 38px;
    margin-top: 4px;
    color: rgb(15, 27, 27);
    background-color: var(--accent);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.command-start-button:disabled {
    color: var(--muted-ink);
    background-color: rgb(28, 57, 57);
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.command-workshop-section {
    border-top-width: 1px;
    border-top-color: var(--panel-edge);
    padding-top: 4px;
}

.command-workshop-section .command-center-section-title {
    margin-top: 10px;
}

.command-workshop-button {
    height: 34px;
    margin-left: 18px;
}

.command-center-message {
    min-height: 16px;
    margin-top: 12px;
}

.hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
}

.turret-status {
    position: absolute;
    left: 28px;
    bottom: 28px;
    width: 224px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: var(--panel);
    border-left-width: 2px;
    border-left-color: var(--panel-edge);
    border-bottom-width: 1px;
    border-bottom-color: var(--panel-edge);
}

.turret-status-title {
    color: var(--accent);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.turret-stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 18px;
}

.turret-stat-row-spaced {
    margin-top: 8px;
}

.turret-stat-label {
    color: var(--muted-ink);
    font-size: 10px;
    letter-spacing: 1px;
}

.turret-stat-value {
    color: var(--ink);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.health-bar {
    height: 8px;
    margin-top: 2px;
    background-color: rgb(35, 50, 48);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.health-bar-fill {
    height: 100%;
    width: 100%;
    background-color: var(--accent);
}

.turret-ammo-value {
    color: var(--accent);
}

.target-value {
    color: var(--accent);
    font-size: 16px;
    -unity-font-style: bold;
}

.skill-bar-container {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 28px;
    align-items: center;
}

.turret-target-outline {
    position: absolute;
    width: 56px;
    height: 56px;
    display: none;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.skill-bar {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.skill-slot {
    width: 72px;
    height: 72px;
    margin-left: 6px;
    margin-right: 6px;
}

.skill-icon {
    width: 100%;
    height: 100%;
    background-color: rgb(28, 57, 57);
    -unity-background-scale-mode: scale-and-crop;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.skill-uses {
    color: var(--ink);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(8, 18, 22);
}

.skill-recharge-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.dash-direction-indicator {
    position: absolute;
    width: 48px;
    height: 48px;
    display: none;
    color: var(--accent);
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(8, 18, 22);
}

.held-direction-indicator {
    position: absolute;
    width: 48px;
    height: 48px;
    display: none;
    color: var(--muted-ink);
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(8, 18, 22);
}

.workshop-open-button {
    position: absolute;
    top: 24px;
    right: 28px;
    height: 34px;
    color: var(--ink);
    background-color: var(--panel);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
    font-size: 11px;
}

.workshop-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 11, 13, 0.82);
}

.workshop-panel {
    width: 620px;
    max-height: 88%;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 20px;
    padding-bottom: 18px;
    background-color: var(--panel);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
}

.workshop-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.workshop-title {
    color: var(--accent);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.workshop-subtitle {
    color: var(--muted-ink);
    font-size: 10px;
    letter-spacing: 1px;
}

.workshop-close-button,
.workshop-action-button {
    color: var(--ink);
    background-color: rgb(28, 57, 57);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--panel-edge);
    border-right-color: var(--panel-edge);
    border-top-color: var(--panel-edge);
    border-bottom-color: var(--panel-edge);
    font-size: 11px;
}

.workshop-close-button {
    height: 30px;
}

.workshop-scroll {
    flex-grow: 1;
}

.workshop-section-title {
    color: var(--accent);
    margin-top: 12px;
    margin-bottom: 5px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.workshop-resource-list,
.workshop-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.workshop-resource {
    color: var(--ink);
    min-width: 90px;
    margin-right: 8px;
    font-size: 11px;
}

.workshop-action-button {
    min-height: 32px;
    margin-right: 6px;
    margin-bottom: 6px;
    white-space: normal;
}

.workshop-bullet-selected {
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.workshop-details {
    color: var(--muted-ink);
    white-space: normal;
    margin-top: 4px;
    font-size: 11px;
}

.workshop-slot-row {
    flex-direction: row;
    align-items: center;
}

.workshop-unequip-button {
    color: var(--danger);
    min-height: 32px;
    margin-right: 6px;
    margin-bottom: 6px;
    background-color: transparent;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--danger);
    border-right-color: var(--danger);
    border-top-color: var(--danger);
    border-bottom-color: var(--danger);
}

.workshop-status {
    min-height: 20px;
    color: var(--muted-ink);
    margin-top: 8px;
    font-size: 11px;
}

@media (max-width: 600px) {
    .menu-panel {
        width: 90%;
        min-height: 440px;
        padding-left: 24px;
        padding-right: 24px;
    }

    .title {
        font-size: 40px;
    }

    .menu-button {
        width: 100%;
    }

    .turret-status {
        left: 16px;
        bottom: 16px;
        width: 200px;
    }

    .skill-bar-container {
        bottom: 92px;
    }

    .workshop-panel {
        width: 90%;
    }

    .command-center-panel {
        width: 90%;
    }

    .command-area {
        width: 100%;
    }

}
