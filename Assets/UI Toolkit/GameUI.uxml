<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <Style src="project://database/Assets/UI%20Toolkit/GameUI.uss?fileID=7433441132597877224&amp;guid=11f23716eda1dfc49aae07857fa6dba1&amp;type=3#GameUI" />
    <ui:VisualElement name="menu-screen" class="screen">
        <ui:VisualElement class="menu-panel">
            <ui:Label text="TURRET LOVE" class="kicker" />
            <ui:Label text="MAIN MENU" class="title" />
            <ui:Label text="DEFEND. ADAPT. SURVIVE." class="subtitle" />
            <ui:Button name="play-button" text="PLAY" class="menu-button" />
            <ui:Button name="save-selection-button" text="SAVE SELECTION" class="menu-button" />
            <ui:Button name="options-button" text="OPTIONS" class="menu-button" />
            <ui:Button name="exit-button" text="EXIT" class="menu-button exit-button" />
            <ui:Label name="status-label" class="status" />
        </ui:VisualElement>
        <ui:Label text="SYSTEM ONLINE  //  BUILD 01" class="footer" />
    </ui:VisualElement>
    <ui:VisualElement name="save-selection-overlay" class="save-selection-overlay">
        <ui:VisualElement class="save-selection-panel">
            <ui:Label text="SAVE SELECTION" class="save-selection-title" />
            <ui:Label name="save-selection-message" class="save-selection-message" />
            <ui:VisualElement name="save-slot-list" class="save-slot-list" />
            <ui:Button name="save-selection-back-button" text="BACK" class="save-selection-back-button" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="command-center-overlay" class="command-center-overlay">
        <ui:VisualElement class="command-center-panel">
            <ui:VisualElement class="command-center-header">
                <ui:VisualElement>
                    <ui:Label text="COMMAND CENTER" class="command-center-title" />
                    <ui:Label name="command-center-save-label" class="command-center-save-label" />
                </ui:VisualElement>
                <ui:Button name="command-center-back-button" text="BACK" class="command-center-back-button" />
            </ui:VisualElement>
            <ui:Label text="MISSION SELECTION" class="command-center-section-title" />
            <ui:Label name="command-center-selection-label" class="command-center-selection-label" />
            <ui:Label text="All areas currently use the same combat environment." class="command-center-note" />
            <ui:VisualElement class="command-area-grid">
                <ui:VisualElement class="command-area">
                    <ui:Label text="AREA 1" class="command-area-title" />
                    <ui:VisualElement class="command-level-row">
                        <ui:Button text="LEVEL 1" class="command-level-button" />
                        <ui:Button text="LEVEL 2" class="command-level-button" />
                        <ui:Button text="LEVEL 3" class="command-level-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="command-area">
                    <ui:Label text="AREA 2" class="command-area-title" />
                    <ui:VisualElement class="command-level-row">
                        <ui:Button text="LEVEL 1" class="command-level-button" />
                        <ui:Button text="LEVEL 2" class="command-level-button" />
                        <ui:Button text="LEVEL 3" class="command-level-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="command-area">
                    <ui:Label text="AREA 3" class="command-area-title" />
                    <ui:VisualElement class="command-level-row">
                        <ui:Button text="LEVEL 1" class="command-level-button" />
                        <ui:Button text="LEVEL 2" class="command-level-button" />
                        <ui:Button text="LEVEL 3" class="command-level-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="command-area">
                    <ui:Label text="AREA 4" class="command-area-title" />
                    <ui:VisualElement class="command-level-row">
                        <ui:Button text="LEVEL 1" class="command-level-button" />
                        <ui:Button text="LEVEL 2" class="command-level-button" />
                        <ui:Button text="LEVEL 3" class="command-level-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="command-center-start-button" text="START SELECTED LEVEL" class="command-start-button" />
            <ui:VisualElement class="command-workshop-section">
                <ui:VisualElement>
                    <ui:Label text="BULLET WORKSHOP" class="command-center-section-title" />
                    <ui:Label text="Craft, modify, and equip bullets before deployment." class="command-center-note" />
                </ui:VisualElement>
                <ui:Button name="command-center-workshop-button" text="OPEN WORKSHOP" class="command-workshop-button" />
            </ui:VisualElement>
            <ui:Label name="command-center-message" class="command-center-message" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="game-hud" class="hud">
        <ui:VisualElement class="turret-status">
            <ui:Label text="TURRET // STATUS" class="turret-status-title" />
            <ui:VisualElement class="turret-stat-row">
                <ui:Label text="INTEGRITY" class="turret-stat-label" />
                <ui:Label name="turret-health-label" text="-- / --" class="turret-stat-value" />
            </ui:VisualElement>
            <ui:VisualElement class="health-bar">
                <ui:VisualElement name="turret-health-fill" class="health-bar-fill" />
            </ui:VisualElement>
            <ui:VisualElement class="turret-stat-row turret-stat-row-spaced">
                <ui:Label text="AMMO" class="turret-stat-label" />
                <ui:Label name="turret-ammo-label" text="-- / --" class="turret-stat-value turret-ammo-value" />
            </ui:VisualElement>
            <ui:VisualElement class="turret-stat-row">
                <ui:Label text="TARGET" class="turret-stat-label" />
                <ui:Label name="turret-target-label" text="NONE" class="turret-stat-value target-value" />
            </ui:VisualElement>
            <ui:VisualElement class="turret-stat-row">
                <ui:Label text="TARGET HP" class="turret-stat-label" />
                <ui:Label name="turret-target-health-label" text="--" class="turret-stat-value" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="skill-bar-container">
            <ui:VisualElement name="skill-bar" class="skill-bar" />
        </ui:VisualElement>
        <ui:Button name="workshop-open-button" text="WORKSHOP [B]" class="workshop-open-button" />
        <ui:VisualElement name="turret-target-outline" class="turret-target-outline" />
        <ui:Label name="dash-direction-indicator" class="dash-direction-indicator" />
        <ui:Label name="held-direction-indicator" class="held-direction-indicator" />
    </ui:VisualElement>
    <ui:VisualElement name="workshop-overlay" class="workshop-overlay">
        <ui:VisualElement class="workshop-panel">
            <ui:VisualElement class="workshop-header">
                <ui:VisualElement>
                    <ui:Label text="FIELD WORKSHOP" class="workshop-title" />
                    <ui:Label text="CRAFT • MODIFY • EQUIP" class="workshop-subtitle" />
                </ui:VisualElement>
                <ui:Button name="workshop-close-button" text="CLOSE" class="workshop-close-button" />
            </ui:VisualElement>
            <ui:ScrollView class="workshop-scroll">
                <ui:Label text="RESOURCES" class="workshop-section-title" />
                <ui:VisualElement name="workshop-resource-list" class="workshop-resource-list" />
                <ui:Label text="BULLET RECIPES" class="workshop-section-title" />
                <ui:VisualElement name="workshop-recipe-list" class="workshop-list" />
                <ui:Label text="CRAFTED BULLETS" class="workshop-section-title" />
                <ui:VisualElement name="workshop-bullet-list" class="workshop-list" />
                <ui:Label name="workshop-bullet-details" text="Select a crafted bullet to inspect, modify, or equip it." class="workshop-details" />
                <ui:Label text="MODIFIERS" class="workshop-section-title" />
                <ui:VisualElement name="workshop-modifier-list" class="workshop-list" />
                <ui:Label text="EQUIPPED MAGAZINE (FIRES 1 → 4)" class="workshop-section-title" />
                <ui:VisualElement name="workshop-equipment-slots" class="workshop-list" />
            </ui:ScrollView>
            <ui:Label name="workshop-status" class="workshop-status" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>