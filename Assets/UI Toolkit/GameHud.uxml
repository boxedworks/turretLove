<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="game-hud" class="hud">
        <ui:VisualElement class="turret-status">
            <ui:Label text="TURRET // STATUS" class="turret-status-title" />
            <ui:VisualElement class="turret-stat-row"><ui:Label text="INTEGRITY" class="turret-stat-label" /><ui:Label name="turret-health-label" text="-- / --" class="turret-stat-value" /></ui:VisualElement>
            <ui:VisualElement class="health-bar"><ui:VisualElement name="turret-health-fill" class="health-bar-fill" /></ui:VisualElement>
            <ui:VisualElement class="turret-stat-row turret-stat-row-spaced"><ui:Label text="AMMO" class="turret-stat-label" /><ui:Label name="turret-ammo-label" text="-- / --" class="turret-stat-value turret-ammo-value" /></ui:VisualElement>
            <ui:VisualElement class="turret-stat-row"><ui:Label text="TARGET" class="turret-stat-label" /><ui:Label name="turret-target-label" text="NONE" class="turret-stat-value target-value" /></ui:VisualElement>
            <ui:VisualElement class="turret-stat-row"><ui:Label text="TARGET HP" class="turret-stat-label" /><ui:Label name="turret-target-health-label" text="--" class="turret-stat-value" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="skill-bar-container"><ui:VisualElement name="skill-bar" class="skill-bar" /></ui:VisualElement>
        <ui:Button name="workshop-open-button" text="WORKSHOP [B]" class="workshop-open-button" />
        <ui:VisualElement name="turret-target-outline" class="turret-target-outline" />
        <ui:Label name="dash-direction-indicator" class="dash-direction-indicator" />
        <ui:Label name="held-direction-indicator" class="held-direction-indicator" />
    </ui:VisualElement>
</ui:UXML>
